# Copy to .env and fill in locally. Never commit .env.
# On Vercel, set these in Project Settings > Environment Variables.

# FRED (St. Louis Fed) API key. Used only by the build-time snapshot script.
FRED_API_KEY=

# LLM provider (OpenAI-compatible Chat Completions endpoint).
LLM_BASE_URL=https://api.sailresearch.com/v1
LLM_API_KEY=
LLM_MODEL=

# Upstash Redis (daily AI usage caps). Not needed until Phase 8.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing client IPs before they are used as rate-limit keys.
IP_HASH_SALT=

# Daily caps on AI endpoint calls.
AI_LIMIT_PER_IP_PER_DAY=
AI_LIMIT_GLOBAL_PER_DAY=

# Local development only: an in-process rate-limit counter instead of Upstash.
# Refused when running on Vercel. Leave unset in production.
# RATE_LIMIT_BACKEND=memory
