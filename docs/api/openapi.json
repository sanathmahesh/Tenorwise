 "openapi": "3.1.0",
 "paths": {
  "/api/agent/ask": {
   "post": {
    "description": "Answer a plain-English question; every number is verified against the engine.",
    "operationId": "agent_ask_api_agent_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
